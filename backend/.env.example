# Conexión a PostgreSQL
DATABASE_URL="postgresql://USUARIO:PASSWORD@localhost:5432/reservas_canchas?schema=public"

# Puerto del servidor NestJS (el frontend Next.js usa el 3000)
PORT=3001

# Origenes permitidos por CORS, separados por coma
CORS_ORIGIN="http://localhost:3000"

# Secretos de autenticación (los usa el change de auth; nunca commitear .env)
JWT_SECRET="cambiar-por-un-secret-largo-y-aleatorio"
JWT_EXPIRES_IN="1h"

# Semilla de bcrypt para el password del admin que crea prisma/seed.ts
SEED_ADMIN_PASSWORD="Admin123!"